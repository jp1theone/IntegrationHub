{
  "ConnectionStrings": {
    "IntegrationHub": ""
  },
  "Jwt": {
    "Issuer": "IntegrationHub.Api",
    "Audience": "IntegrationHub.Web",
    "AccessTokenMinutes": 30
  },
  "IntegrationRuntime": {
    "Mode": "Simulation"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Retry": {
    "WorkerEnabled": true,
    "PollIntervalMs": 2000,
    "BatchSize": 20,
    "MaxAttempts": 3,
    "InitialDelaySeconds": 5,
    "BackoffMultiplier": 2
  },
  "Sla": {
    "WindowDays": 30,
    "AvailabilityTargetPercent": 99,
    "MaximumAverageDurationMs": 2000
  },
  "RateLimiting": {
    "AuthPermitLimit": 5,
    "WebhookPermitLimit": 60
  },
  "Webhooks": {
    "WorkerEnabled": true,
    "PollIntervalMs": 1000
  },
  "Logging": {
    "IncludeScopes": true,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
